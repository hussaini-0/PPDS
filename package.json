{
  "name": "ppds",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/run-next-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "test:e2e": "playwright test",
    "readiness:check": "node scripts/validate-production-readiness.mjs",
    "readiness:production": "node scripts/validate-production-readiness.mjs --production .env.production",
    "smoke:production": "node --env-file=.env.production scripts/smoke-production.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "worker:followups": "tsx worker/follow-up-worker.ts",
    "worker:subscriptions": "tsx worker/subscription-worker.ts",
    "worker:broadcasts": "tsx worker/broadcast-worker.ts",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@faker-js/faker": "^10.5.0",
    "@hookform/resolvers": "^5.5.7",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.28.0",
    "next": "^16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.22.0",
    "prisma": "^7.10.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "redis": "^6.1.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "fast-uri": "3.1.8",
    "nanoid": "3.3.18",
    "source-map-js": "1.2.2"
  }
}
