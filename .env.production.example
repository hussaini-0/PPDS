# Copy to .env.production and replace every placeholder before deployment.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ppds?sslmode=require
REDIS_URL=rediss://USER:PASSWORD@HOST:6379
AUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=https://example.com
BUSINESS_TIMEZONE=Asia/Karachi
DEFAULT_CURRENCY=PKR
INTEGRATION_MODE=live
META_GRAPH_API_VERSION=v23.0
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PUBLIC_NUMBER=
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_CONFIDENCE_THRESHOLD=0.7
FILE_STORAGE_PROVIDER=s3
FILE_STORAGE_PATH=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=replace-with-private-bucket
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
PUBLIC_ASSET_BASE_URL=
ENCRYPTION_KEY=replace-with-at-least-32-random-characters
SUBSCRIPTION_JOB_INTERVAL_MS=86400000
LOG_LEVEL=info
