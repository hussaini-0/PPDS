FILE_STORAGE_PROVIDER=local
FILE_STORAGE_PATH=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
PUBLIC_ASSET_BASE_URL=
ENCRYPTION_KEY=replace-with-32-bytes-minimum
